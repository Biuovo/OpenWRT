#!/bin/sh

# Keep the CPU description in LuCI's Architecture field, like ImmortalWrt.
model="$(awk -F ': ' '/^(model name|Model|Processor)[[:space:]]*:/ { print $2; exit }' /proc/cpuinfo 2>/dev/null)"
[ -n "$model" ] || model="ARMv8 Processor"

cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ "$cores" -gt 0 ] 2>/dev/null || cores=1

# Only show one representative frequency from each RK3588 cluster:
# CPU0 is a little core and CPU4 is a big core.
read_cpu_freq() {
	cpu="$1"
	for f in \
		"/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_cur_freq" \
		"/sys/devices/system/cpu/cpu${cpu}/cpufreq/cpuinfo_cur_freq" \
		"/sys/devices/system/cpu/cpufreq/policy${cpu}/scaling_cur_freq" \
		"/sys/devices/system/cpu/cpufreq/policy${cpu}/cpuinfo_cur_freq"; do
		[ -r "$f" ] || continue
		v="$(cat "$f" 2>/dev/null)"
		case "$v" in
			''|*[!0-9]*) continue ;;
		esac
		printf '%dMHz' "$((v / 1000))"
		return 0
	done
	return 1
}

little_freq="$(read_cpu_freq 0)"
big_freq="$(read_cpu_freq 4)"

if [ -n "$little_freq" ] && [ -n "$big_freq" ]; then
	freq_text="$little_freq/$big_freq"
elif [ -n "$little_freq" ]; then
	freq_text="$little_freq"
else
	freq_text="$big_freq"
fi

temp_text="$(/sbin/tempinfo 2>/dev/null | sed 's/^CPU:[[:space:]]*//')"
details=""
if [ -n "$freq_text" ] && [ -n "$temp_text" ]; then
	details="$freq_text, $temp_text"
elif [ -n "$freq_text" ]; then
	details="$freq_text"
elif [ -n "$temp_text" ]; then
	details="$temp_text"
fi

if [ -n "$details" ]; then
	printf '%s x %s (%s)' "$model" "$cores" "$details"
else
	printf '%s x %s' "$model" "$cores"
fi
