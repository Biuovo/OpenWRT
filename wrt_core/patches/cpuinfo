#!/bin/sh

# Keep the CPU description in LuCI's Architecture field, like ImmortalWrt.
# Rockchip exposes current frequency under cpufreq policy directories rather
# than per-CPU directories, so check both layouts.
model="$(awk -F ': ' '/^(model name|Model|Processor)[[:space:]]*:/ { print $2; exit }' /proc/cpuinfo 2>/dev/null)"
[ -n "$model" ] || model="ARMv8 Processor"

cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
[ "$cores" -gt 0 ] 2>/dev/null || cores=1

freqs=""
for f in \
	/sys/devices/system/cpu/cpufreq/policy*/cpuinfo_cur_freq \
	/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
	/sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_cur_freq \
	/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
	[ -r "$f" ] || continue
	v="$(cat "$f" 2>/dev/null)"
	case "$v" in
		''|*[!0-9]*) continue ;;
	esac
	freqs="$freqs $v"
done

freq_text=""
if [ -n "$freqs" ]; then
	freq_text="$(printf '%s\n' "$freqs" | tr ' ' '\n' | awk 'NF {print int($1/1000)}' | sort -n | uniq | awk '
BEGIN { first=1 }
{
	if (!first) printf "/";
	printf "%dMHz", $1;
	first=0;
}')"
fi

temp_text="$(/sbin/tempinfo 2>/dev/null | sed 's/^CPU:[[:space:]]*//')"
details=""
if [ -n "$freq_text" ] && [ -n "$temp_text" ]; then
	details="$freq_text, $temp_text"
elif [ -n "$freq_text" ]; then
	details="$freq_text"
elif [ -n "$temp_text" ]; then
	details="$temp_text"
fi

if [ -n "$details" ]; then
	printf '%s x %s (%s)' "$model" "$cores" "$details"
else
	printf '%s x %s' "$model" "$cores"
fi
