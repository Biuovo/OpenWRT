#!/bin/sh

# Return a stable CPU usage value for the LuCI system overview.
usage="$(top -bn1 2>/dev/null | awk '
/^CPU:/ {
	for (i = 1; i <= NF; i++) {
		if ($(i + 1) == "idle") {
			gsub(/%/, "", $i)
			printf "%d%%", 100 - $i
			exit
		}
	}
}')"

[ -n "$usage" ] || usage="$(awk '
NR == 1 {
	total = 0
	for (i = 2; i <= NF; i++) total += $i
	busy = total - $5 - $6
	if (total > 0) printf "%d%%", busy * 100 / total
}' /proc/stat 2>/dev/null)"

printf '%s' "${usage:-0%}"
