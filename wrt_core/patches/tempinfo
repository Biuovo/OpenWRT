#!/bin/sh

best_name=""
best_temp=""

for z in /sys/class/thermal/thermal_zone*; do
	[ -r "$z/temp" ] || continue
	type="$(cat "$z/type" 2>/dev/null)"
	temp="$(cat "$z/temp" 2>/dev/null)"
	case "$temp" in
		''|*[!0-9-]*) continue ;;
	esac
	# Ignore bogus sensors.
	[ "$temp" -gt 0 ] 2>/dev/null || continue
	[ "$temp" -lt 120000 ] 2>/dev/null || continue

	case "$type" in
		*cpu*|*CPU*|*soc*|*SOC*|*thermal*|*rockchip*)
			best_name="$type"
			best_temp="$temp"
			break
			;;
	esac

	[ -n "$best_temp" ] || { best_name="$type"; best_temp="$temp"; }
done

[ -n "$best_temp" ] || { echo -n "N/A"; exit 0; }

awk -v name="$best_name" -v temp="$best_temp" 'BEGIN {
	if (temp >= 1000 || temp <= -1000) temp = temp / 1000;
	if (name == "") name = "CPU";
	printf "%s: %.1f°C", name, temp;
}'
