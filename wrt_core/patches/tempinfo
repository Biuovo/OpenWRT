#!/bin/sh

# Report the SoC/CPU thermal zone used by Rockchip boards.
best_temp=""

for z in /sys/class/thermal/thermal_zone*; do
	[ -r "$z/temp" ] || continue
	type="$(cat "$z/type" 2>/dev/null)"
	temp="$(cat "$z/temp" 2>/dev/null)"
	case "$temp" in
		''|*[!0-9-]*) continue ;;
	esac
	# Ignore bogus sensors and prefer CPU/SoC thermal zones.
	[ "$temp" -gt 0 ] 2>/dev/null || continue
	[ "$temp" -lt 120000 ] 2>/dev/null || continue

	case "$type" in
		*cpu*|*CPU*|*soc*|*SOC*|*thermal*|*rockchip*)
			best_temp="$temp"
			break
			;;
		*)
			[ -n "$best_temp" ] || best_temp="$temp"
			;;
	esac
done

# An absent sensor should not create an "N/A" row in LuCI.
[ -n "$best_temp" ] || exit 0

awk -v temp="$best_temp" 'BEGIN {
	if (temp >= 1000 || temp <= -1000) temp = temp / 1000;
	printf "CPU: %.1f°C", temp;
}'
